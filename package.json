{
  "name": "foody-clear-front",
  "version": "1.0.0-alpha.1",
  "description": "Angular frontend for the Foody Clear food management application.",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "ATOKODO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATOKODO/foody-clear-front.git"
  },
  "homepage": "https://github.com/ATOKODO/foody-clear-front#readme",
  "keywords": [
    "angular",
    "food-management",
    "inventory",
    "meal-planning",
    "nutrition",
    "shopping-list"
  ],
  "scripts": {
    "ng": "ng",
    "storybook": "ng run foody-clear-front:storybook",
    "build-storybook": "ng run foody-clear-front:build-storybook",
    "storybook:check": "node scripts/check-storybook.mjs && node --test scripts/storybook-docgen.test.mjs && tsc -p .storybook/tsconfig.json --noEmit",
    "storybook:test": "playwright test --config=playwright.storybook.config.ts",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:i18n": "node --test scripts/i18n-inventory.test.mjs",
    "test:coverage": "ng test --no-watch --code-coverage --browsers=ChromeHeadless",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "e2e:headed": "playwright test --headed",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:report": "playwright show-report",
    "e2e:vrt": "playwright test --config=playwright.visual.config.ts",
    "e2e:vrt:update": "npm run e2e:vrt -- --update-snapshots=all",
    "e2e:vrt:report": "playwright show-report playwright-report/visual",
    "lint": "ng lint",
    "style:check": "node scripts/check-styles.mjs",
    "e2e:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts",
    "docs:install": "npm --prefix docs ci",
    "docs:dev": "npm --prefix docs run dev --",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview --"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "22.0.7",
    "@angular/cdk": "22.0.2",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@angular/service-worker": "22.0.7",
    "@ngrx/signals": "^21.1.0",
    "@zxing/browser": "0.2.0",
    "@zxing/library": "0.22.0",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "vite": "^8.0.5",
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "4.9.1",
    "postcss": "^8.5.6",
    "sass-embedded": "1.105.1",
    "storybook": "10.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
